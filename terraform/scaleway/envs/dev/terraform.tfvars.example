# Renomme en terraform.tfvars (gitignoré).
# Cet env est nommé "dev" par défaut — RENOMME via env_name (et le dir parent) selon ton besoin :
# "staging", "preprod", "qa", ...

env_name     = "dev"           # OU "staging", "preprod", "qa", etc.
project_slug = "myapp"

# === Scaleway === (mêmes credentials que prod si même compte/projet)
scaleway_access_key      = "SCWXXXXXXXXXXXXXXXXX"
scaleway_secret_key      = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
scaleway_project_id      = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
scaleway_organization_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
scaleway_region          = "fr-par"
scaleway_zone            = "fr-par-1"

vps_type                = "DEV1-S"          # moins cher pour dev
vps_root_volume_size_gb = 20

ssh_public_key = "ssh-ed25519 AAAA... your-key"

# === DB ===
# Pour dev tu peux choisir "vps" (DB en docker, économique) plutôt que "scaleway".
db_provider       = "vps"          # ou "scaleway"
db_engine         = "postgresql"   # ou "mariadb"
db_engine_version = ""
db_node_type      = "db-dev-s"     # ignoré si db_provider=vps
db_volume_size_gb = 10
db_name           = "app_dev"
db_user           = "appuser"

# === Cloudflare ===
cloudflare_api_token  = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
cloudflare_account_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
cloudflare_zone_id    = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

domain    = "example.com"
subdomain = "dev"              # → dev.example.com + *.dev.example.com

extra_dns_records = []

# === Cloudflare R2 ===
r2_enabled           = true
r2_access_key_id     = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
r2_secret_access_key = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
