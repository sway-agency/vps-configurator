*filter
:INPUT DROP [0:0]
# FORWARD: ACCEPT — Docker gère ses chains lui-même (cf. règles v4).
# Docker n'utilise pas IPv6 par défaut, donc pas de DOCKER-USER ici.
:FORWARD ACCEPT [0:0]
:OUTPUT DROP [0:0]

# ===== INPUT =====
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A INPUT -m conntrack --ctstate INVALID -j DROP

# ICMPv6 (Neighbor Discovery indispensable)
-A INPUT -p ipv6-icmp -j ACCEPT

# SSH
-A INPUT -p tcp --dport {{ ssh_port }} -m conntrack --ctstate NEW -j ACCEPT

{% if honeypot_enabled %}
-A INPUT -p tcp --dport {{ honeypot_port }} -m conntrack --ctstate NEW -j ACCEPT
{% endif %}

{% if open_http_https | default(true) %}
-A INPUT -p tcp --dport 80  -m conntrack --ctstate NEW -j ACCEPT
-A INPUT -p tcp --dport 443 -m conntrack --ctstate NEW -j ACCEPT
{% endif %}

# ===== OUTPUT =====
-A OUTPUT -o lo -j ACCEPT
-A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# HTTP / HTTPS (apt, docker pull, R2, etc.) — Linux peut tenter IPv6 d'abord
-A OUTPUT -p tcp --dport 80  -m conntrack --ctstate NEW -j ACCEPT
-A OUTPUT -p tcp --dport 443 -m conntrack --ctstate NEW -j ACCEPT

# DNS
-A OUTPUT -p udp --dport 53 -m conntrack --ctstate NEW -j ACCEPT
-A OUTPUT -p tcp --dport 53 -m conntrack --ctstate NEW -j ACCEPT

# NTP
-A OUTPUT -p udp --dport 123 -m conntrack --ctstate NEW -j ACCEPT

-A OUTPUT -p ipv6-icmp -j ACCEPT

COMMIT
